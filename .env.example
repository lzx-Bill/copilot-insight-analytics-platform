# =============================================================
# Copilot Insight Analytics Platform - 配置文件
# =============================================================
# 复制此文件为 .env 并根据需要修改配置
# cp .env.example .env
# =============================================================

# -------------------------------------------------------------
# 服务端口配置
# -------------------------------------------------------------
# 后端 API 端口
BACKEND_PORT=8847

# 前端 Web 端口
FRONTEND_PORT=5173

# -------------------------------------------------------------
# MongoDB 配置
# -------------------------------------------------------------
MONGODB_PORT=27847
MONGODB_ROOT_USERNAME=ciap_admin
MONGODB_ROOT_PASSWORD=change_me
MONGODB_DB_NAME=copilot_insight

# MongoDB 连接 URL (Docker 内部使用)
MONGODB_URL=mongodb://ciap_admin:change_me@mongodb:27017/?authSource=admin

# MongoDB 连接 URL (本地开发使用)
# MONGODB_URL=mongodb://ciap_admin:change_me@localhost:27847/?authSource=admin

# -------------------------------------------------------------
# Redis 配置
# -------------------------------------------------------------
REDIS_PORT=6847
REDIS_PASSWORD=change_me

# Redis 连接 URL (Docker 内部使用)
REDIS_URL=redis://:change_me@redis:6847/0

# Redis 连接 URL (本地开发使用)
# REDIS_URL=redis://:change_me@localhost:6847/0

# -------------------------------------------------------------
# Elasticsearch 配置 (可选 - Phase 2)
# -------------------------------------------------------------
ELASTICSEARCH_HOST=elasticsearch:9200
ELASTICSEARCH_ENABLED=false

# -------------------------------------------------------------
# API 配置
# -------------------------------------------------------------
API_V1_PREFIX=/api/v1
PROJECT_NAME=Copilot Insight Analytics Platform
VERSION=1.0.0
DEBUG=true

# CORS 允许的来源 (JSON 数组格式)
BACKEND_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# -------------------------------------------------------------
# 前端配置
# -------------------------------------------------------------
VITE_API_BASE_URL=http://localhost:8847/api/v1
